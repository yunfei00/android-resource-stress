<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/monitorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nav_monitor" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
        <Button android:id="@+id/deviceInfoButton" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="@string/device_info" android:textSize="11sp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <TextView android:id="@+id/monitorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:lineSpacingExtra="3dp" android:padding="16dp" android:text="@string/monitor_waiting" android:textColor="@color/text_primary" android:textSize="13sp" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:paddingHorizontal="8dp">
        <Button android:id="@+id/stressNavButton" style="@style/BottomNavButton" android:text="@string/nav_stress" />
        <Button android:id="@+id/monitorNavButton" style="@style/BottomNavButton" android:enabled="false" android:text="@string/nav_monitor" />
        <Button android:id="@+id/historyNavButton" style="@style/BottomNavButton" android:text="@string/nav_history" />
    </LinearLayout>
</LinearLayout>
